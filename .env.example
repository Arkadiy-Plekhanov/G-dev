# Copy to .env before running `docker compose up`. Never commit the real .env.

# Password for the app_writer role. Must match database/01_schema_v2_multitenant_BASE.sql's
# CREATE ROLE line EXACTLY -- that file hardcodes 'change_me_in_production'. For local dev this
# is fine to leave as-is; for anything beyond Tier 1, change BOTH the SQL and this value together.
APP_WRITER_PASSWORD=change_me_in_production

# Backend
JWT_SECRET=dev-only-secret-change-me
GOOGLE_CLIENT_ID=REPLACE-WITH-REAL-GOOGLE-OAUTH-WEB-CLIENT-ID.apps.googleusercontent.com

# Frontend
VITE_GOOGLE_CLIENT_ID=REPLACE-WITH-REAL-GOOGLE-OAUTH-WEB-CLIENT-ID.apps.googleusercontent.com
