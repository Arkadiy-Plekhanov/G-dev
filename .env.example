# Copy to .env before running `docker compose up`. Never commit the real .env.

# Password for the app_writer role. Must match database/01_schema_v2_multitenant_BASE.sql's
# CREATE ROLE line EXACTLY -- that file hardcodes 'change_me_in_production'. For local dev this
# is fine to leave as-is; for anything beyond Tier 1, change BOTH the SQL and this value together.
APP_WRITER_PASSWORD=change_me_in_production

# Backend
JWT_SECRET=dev-only-secret-change-me
GOOGLE_CLIENT_ID=REPLACE-WITH-REAL-GOOGLE-OAUTH-WEB-CLIENT-ID.apps.googleusercontent.com

# Frontend
# Vite dev server talks to the backend at this exact URL. The variable name
# must be VITE_API_BASE_URL -- client.js reads exactly this name (a
# different name, e.g. VITE_API_URL, is silently ignored: Vite just won't
# find it, and client.js falls back to its own hardcoded default). In
# Docker Compose this specific value is also hardcoded directly in
# docker-compose.yml's `environment:` block for the frontend service (which
# always wins over env_file), so getting this line wrong here is currently
# harmless under Docker -- but keep it correct so this file stays
# trustworthy if you ever run the frontend outside Compose.
VITE_API_BASE_URL=http://127.0.0.1:8000/v1
VITE_GOOGLE_CLIENT_ID=REPLACE-WITH-REAL-GOOGLE-OAUTH-WEB-CLIENT-ID.apps.googleusercontent.com
